# Port to run the Express server on
PORT=3000

# Active provider: groq | openrouter | huggingface | demo | vllm | ollama
PROVIDER=groq

# Groq Hosted Inference (Free tier available at https://console.groq.com)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=meta-llama/llama-prompt-guard-2-22m

# OpenRouter Hosted Inference (Free tier available at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Hugging Face Inference Providers (https://router.huggingface.co/v1)
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=google/gemma-4-31B-it:novita

# vLLM Self-Hosted Instance (optional, for GPU clusters / Docker)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=mistralai/Mistral-Large-4-1T-A52B
VLLM_API_KEY=

# Rate limiting settings
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
